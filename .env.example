# Docker / VPS only (not needed on Hostinger shared hosting). Copy this file to .env and change every value.

# Domain that points to your VPS (A record). Caddy gets the HTTPS certificate for it.
DOMAIN=time.example.com

# Database password.
DB_PASSWORD=change-me-long-random

# Random secret used to sign logins. Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-run-openssl-rand-hex-32

# First admin account, created the first time the server starts.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# People can create their own account on the sign-in page; an admin must approve it. Set to false to switch that off.
ALLOW_SIGNUP=true
